{
  "type": "record",
  "name": "CustomerContext",
  "namespace": "io.confluent.dtm",
  "doc": "Current per-customer context maintained by Flink.",
  "fields": [
    {
      "name": "envelope",
      "type": "io.confluent.dtm.Envelope"
    },
    {
      "name": "device_count",
      "type": [
        "null",
        "int"
      ],
      "default": null
    },
    {
      "name": "trusted_device_count",
      "type": [
        "null",
        "int"
      ],
      "default": null
    },
    {
      "name": "known_countries",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Comma-separated country codes"
    },
    {
      "name": "recent_anomaly_count",
      "type": [
        "null",
        "int"
      ],
      "default": null
    },
    {
      "name": "account_age_days",
      "type": [
        "null",
        "int"
      ],
      "default": null
    },
    {
      "name": "last_country",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "last_event_time",
      "type": [
        "null",
        {
          "type": "long",
          "logicalType": "timestamp-millis"
        }
      ],
      "default": null
    }
  ]
}
