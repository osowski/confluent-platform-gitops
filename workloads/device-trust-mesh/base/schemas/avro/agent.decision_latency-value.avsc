{
  "type": "record",
  "name": "DecisionLatency",
  "namespace": "io.confluent.dtm",
  "doc": "One row per decision artifact, joined to the router task that started its leg.",
  "fields": [
    {
      "name": "device_id",
      "type": "string"
    },
    {
      "name": "customer_id",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "correlation_id",
      "type": "string"
    },
    {
      "name": "device_seq",
      "type": [
        "null",
        "long"
      ],
      "default": null
    },
    {
      "name": "agent",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "task_id",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "artifact_name",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "outcome",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "policy_action",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "rationale",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "event_time",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "The router task's envelope event_time."
    },
    {
      "name": "decision_time",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "The decision artifact's envelope event_time."
    },
    {
      "name": "latency_ms",
      "type": "long",
      "doc": "decision_time minus event_time, in milliseconds."
    }
  ]
}
