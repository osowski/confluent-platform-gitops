{
  "type": "record",
  "name": "CardHumanReadable",
  "namespace": "io.confluent.dtm",
  "doc": "Flattened A2A Agent Card from agent.cards.",
  "fields": [
    {
      "name": "envelope",
      "type": {
        "type": "record",
        "name": "Envelope",
        "namespace": "io.confluent.dtm",
        "doc": "Mesh envelope carried on every device-trust-mesh record. Mirrors the A2A metadata extension urn:device-trust-mesh:envelope:v1.",
        "fields": [
          {
            "name": "message_id",
            "type": "string"
          },
          {
            "name": "correlation_id",
            "type": "string"
          },
          {
            "name": "causation_id",
            "type": [
              "null",
              "string"
            ],
            "default": null
          },
          {
            "name": "agent_id",
            "type": "string",
            "doc": "flink:<statement>, agent:<name> or simulator"
          },
          {
            "name": "agent_version",
            "type": "string"
          },
          {
            "name": "config_version",
            "type": "string",
            "doc": "Hash of the effective agent config; n/a for Flink"
          },
          {
            "name": "event_time",
            "type": {
              "type": "long",
              "logicalType": "timestamp-millis"
            }
          },
          {
            "name": "device_id",
            "type": "string"
          },
          {
            "name": "customer_id",
            "type": [
              "null",
              "string"
            ],
            "default": null
          },
          {
            "name": "device_seq",
            "type": [
              "null",
              "long"
            ],
            "default": null
          },
          {
            "name": "required_context_seq",
            "type": [
              "null",
              "long"
            ],
            "default": null
          },
          {
            "name": "mode",
            "type": {
              "type": "enum",
              "name": "Mode",
              "symbols": [
                "LIVE",
                "REPLAY"
              ]
            }
          },
          {
            "name": "replay_run_id",
            "type": [
              "null",
              "string"
            ],
            "default": null
          }
        ]
      }
    },
    {
      "name": "version",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "description",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "skills",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "JSON array text of skill names"
    },
    {
      "name": "request_topic",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "protocol_binding",
      "type": [
        "null",
        "string"
      ],
      "default": null
    }
  ]
}
