{
  "type": "record",
  "name": "PairCount",
  "namespace": "io.confluent.dtm",
  "doc": "Messages sent per (from_agent, to_agent) pair in one 1-minute window sliding every 5 seconds.",
  "fields": [
    {
      "name": "window_start",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Window start, processing time."
    },
    {
      "name": "window_end",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Window end, processing time."
    },
    {
      "name": "from_agent",
      "type": "string"
    },
    {
      "name": "to_agent",
      "type": "string"
    },
    {
      "name": "message_count",
      "type": "long"
    }
  ]
}
