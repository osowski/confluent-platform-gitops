{
  "type": "record",
  "name": "DeviceEvent",
  "namespace": "io.confluent.dtm",
  "doc": "Device activity produced by the simulator.",
  "fields": [
    {
      "name": "envelope",
      "type": {
        "type": "record",
        "name": "Envelope",
        "namespace": "io.confluent.dtm",
        "doc": "Mesh envelope carried on every device-trust-mesh record. Mirrors the A2A metadata extension urn:device-trust-mesh:envelope:v1.",
        "fields": [
          {
            "name": "message_id",
            "type": "string"
          },
          {
            "name": "correlation_id",
            "type": "string"
          },
          {
            "name": "causation_id",
            "type": [
              "null",
              "string"
            ],
            "default": null
          },
          {
            "name": "agent_id",
            "type": "string",
            "doc": "flink:<statement>, agent:<name> or simulator"
          },
          {
            "name": "agent_version",
            "type": "string"
          },
          {
            "name": "config_version",
            "type": "string",
            "doc": "Hash of the effective agent config; n/a for Flink"
          },
          {
            "name": "event_time",
            "type": {
              "type": "long",
              "logicalType": "timestamp-millis"
            }
          },
          {
            "name": "device_id",
            "type": "string"
          },
          {
            "name": "customer_id",
            "type": [
              "null",
              "string"
            ],
            "default": null
          },
          {
            "name": "device_seq",
            "type": [
              "null",
              "long"
            ],
            "default": null
          },
          {
            "name": "required_context_seq",
            "type": [
              "null",
              "long"
            ],
            "default": null
          },
          {
            "name": "mode",
            "type": {
              "type": "enum",
              "name": "Mode",
              "symbols": [
                "LIVE",
                "REPLAY"
              ]
            }
          },
          {
            "name": "replay_run_id",
            "type": [
              "null",
              "string"
            ],
            "default": null
          }
        ]
      }
    },
    {
      "name": "event_type",
      "type": {
        "type": "enum",
        "name": "EventType",
        "symbols": [
          "ENROL_REQUESTED",
          "UNENROL_REQUESTED",
          "CHALLENGE_PASSED",
          "CHALLENGE_FAILED"
        ]
      }
    },
    {
      "name": "fingerprint",
      "type": {
        "type": "record",
        "name": "Fingerprint",
        "fields": [
          {
            "name": "platform",
            "type": {
              "type": "enum",
              "name": "Platform",
              "symbols": [
                "IOS",
                "ANDROID"
              ]
            }
          },
          {
            "name": "os_version",
            "type": "string"
          },
          {
            "name": "rooted",
            "type": "boolean"
          },
          {
            "name": "browser_signals",
            "type": [
              "null",
              "string"
            ],
            "default": null
          },
          {
            "name": "network_type",
            "type": "string"
          }
        ]
      }
    },
    {
      "name": "geo",
      "type": {
        "type": "record",
        "name": "Geo",
        "fields": [
          {
            "name": "country",
            "type": "string"
          },
          {
            "name": "lat",
            "type": "double"
          },
          {
            "name": "lon",
            "type": "double"
          }
        ]
      }
    },
    {
      "name": "account_age_days",
      "type": "int"
    },
    {
      "name": "enrolment_task_id",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Enrolment task a challenge result resumes"
    }
  ]
}
