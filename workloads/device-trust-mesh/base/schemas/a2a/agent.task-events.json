{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent.task-events",
  "description": "A2A v1.0.1 JSON-RPC reply on agent.task-events: exactly one Task, TaskStatusUpdateEvent or TaskArtifactUpdateEvent (mesh Kafka binding).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jsonrpc",
    "id",
    "result"
  ],
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "id": {
      "description": "JSON-RPC id of the request being answered.",
      "type": "string"
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "task"
          ],
          "properties": {
            "task": {
              "additionalProperties": false,
              "description": "`Task` is the core unit of action for A2A. It has a current status\n and when results are created for the task they are stored in the\n artifact. If there are multiple turns for a task, these are stored in\n history.",
              "properties": {
                "artifacts": {
                  "description": "A set of output artifacts for a `Task`.",
                  "items": {
                    "$ref": "#/$defs/Artifact"
                  },
                  "type": "array"
                },
                "contextId": {
                  "default": "",
                  "description": "Unique identifier (e.g. UUID) for the contextual collection of interactions\n (tasks and messages).",
                  "type": "string"
                },
                "history": {
                  "description": "The history of interactions from a `Task`.",
                  "items": {
                    "$ref": "#/$defs/Message"
                  },
                  "type": "array"
                },
                "id": {
                  "default": "",
                  "description": "Unique identifier (e.g. UUID) for the task, generated by the server for a\n new task.",
                  "type": "string"
                },
                "metadata": {
                  "description": "Carries the mesh envelope.",
                  "type": "object",
                  "required": [
                    "urn:device-trust-mesh:envelope:v1"
                  ],
                  "properties": {
                    "urn:device-trust-mesh:envelope:v1": {
                      "$ref": "#/$defs/Envelope"
                    }
                  }
                },
                "status": {
                  "$ref": "#/$defs/TaskStatus",
                  "description": "The current status of a `Task`, including `state` and a `message`."
                }
              },
              "title": "Task",
              "type": "object",
              "required": [
                "id",
                "contextId",
                "status",
                "metadata"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "statusUpdate"
          ],
          "properties": {
            "statusUpdate": {
              "additionalProperties": false,
              "description": "An event sent by the agent to notify the client of a change in a task's status.",
              "properties": {
                "contextId": {
                  "default": "",
                  "description": "The ID of the context that the task belongs to.",
                  "type": "string"
                },
                "metadata": {
                  "description": "Carries the mesh envelope.",
                  "type": "object",
                  "required": [
                    "urn:device-trust-mesh:envelope:v1"
                  ],
                  "properties": {
                    "urn:device-trust-mesh:envelope:v1": {
                      "$ref": "#/$defs/Envelope"
                    }
                  }
                },
                "status": {
                  "$ref": "#/$defs/TaskStatus",
                  "description": "The new status of the task."
                },
                "taskId": {
                  "default": "",
                  "description": "The ID of the task that has changed.",
                  "type": "string"
                }
              },
              "title": "Task Status Update Event",
              "type": "object",
              "required": [
                "taskId",
                "contextId",
                "status",
                "metadata"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifactUpdate"
          ],
          "properties": {
            "artifactUpdate": {
              "additionalProperties": false,
              "description": "A task delta where an artifact has been generated.",
              "properties": {
                "append": {
                  "default": false,
                  "description": "If true, the content of this artifact should be appended to a previously\n sent artifact with the same ID.",
                  "type": "boolean"
                },
                "artifact": {
                  "additionalProperties": false,
                  "description": "Artifacts represent task outputs.",
                  "properties": {
                    "artifactId": {
                      "default": "",
                      "description": "Unique identifier (e.g. UUID) for the artifact. It must be unique within a task.",
                      "type": "string"
                    },
                    "description": {
                      "default": "",
                      "description": "Optional. A human readable description of the artifact.",
                      "type": "string"
                    },
                    "extensions": {
                      "description": "The URIs of extensions that are present or contributed to this Artifact.",
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "metadata": {
                      "$ref": "#/$defs/Struct",
                      "description": "Optional. Metadata included with the artifact."
                    },
                    "name": {
                      "default": "",
                      "description": "A human readable name for the artifact.",
                      "type": "string"
                    },
                    "parts": {
                      "description": "parts[0] is the typed data part (narrowed by artifact name), parts[1] the text summary.",
                      "type": "array",
                      "prefixItems": [
                        {
                          "additionalProperties": false,
                          "description": "`Part` represents a container for a section of communication content.\n Parts can be purely textual, some sort of file (image, video, etc) or\n a structured data blob (i.e. JSON).",
                          "properties": {
                            "data": {
                              "$ref": "#/$defs/Value"
                            },
                            "filename": {
                              "default": "",
                              "description": "An optional `filename` for the file (e.g., \"document.pdf\").",
                              "type": "string"
                            },
                            "mediaType": {
                              "default": "",
                              "description": "The `media_type` (MIME type) of the part content (e.g., \"text/plain\", \"application/json\", \"image/png\").\n This field is available for all part types.",
                              "type": "string"
                            },
                            "metadata": {
                              "$ref": "#/$defs/Struct",
                              "description": "Optional. metadata associated with this part."
                            },
                            "raw": {
                              "description": "The `raw` byte content of a file. In JSON serialization, this is encoded as a base64 string.",
                              "pattern": "^[A-Za-z0-9+/]*={0,2}$",
                              "type": "string"
                            },
                            "text": {
                              "description": "The string content of the `text` part.",
                              "type": "string"
                            },
                            "url": {
                              "description": "A `url` pointing to the file's content.",
                              "type": "string"
                            }
                          },
                          "title": "Part",
                          "type": "object",
                          "required": [
                            "data"
                          ]
                        },
                        {
                          "additionalProperties": false,
                          "description": "`Part` represents a container for a section of communication content.\n Parts can be purely textual, some sort of file (image, video, etc) or\n a structured data blob (i.e. JSON).",
                          "properties": {
                            "data": {
                              "$ref": "#/$defs/Value",
                              "description": "Arbitrary structured `data` as a JSON value (object, array, string, number, boolean, or null)."
                            },
                            "filename": {
                              "default": "",
                              "description": "An optional `filename` for the file (e.g., \"document.pdf\").",
                              "type": "string"
                            },
                            "mediaType": {
                              "default": "",
                              "description": "The `media_type` (MIME type) of the part content (e.g., \"text/plain\", \"application/json\", \"image/png\").\n This field is available for all part types.",
                              "type": "string"
                            },
                            "metadata": {
                              "$ref": "#/$defs/Struct",
                              "description": "Optional. metadata associated with this part."
                            },
                            "raw": {
                              "description": "The `raw` byte content of a file. In JSON serialization, this is encoded as a base64 string.",
                              "pattern": "^[A-Za-z0-9+/]*={0,2}$",
                              "type": "string"
                            },
                            "text": {
                              "description": "The string content of the `text` part.",
                              "type": "string"
                            },
                            "url": {
                              "description": "A `url` pointing to the file's content.",
                              "type": "string"
                            }
                          },
                          "title": "Part",
                          "type": "object",
                          "required": [
                            "text"
                          ]
                        }
                      ],
                      "minItems": 2
                    }
                  },
                  "title": "Artifact",
                  "type": "object",
                  "required": [
                    "artifactId",
                    "name",
                    "parts"
                  ]
                },
                "contextId": {
                  "default": "",
                  "description": "The ID of the context that this task belongs to.",
                  "type": "string"
                },
                "lastChunk": {
                  "default": false,
                  "description": "If true, this is the final chunk of the artifact.",
                  "type": "boolean"
                },
                "metadata": {
                  "description": "Carries the mesh envelope.",
                  "type": "object",
                  "required": [
                    "urn:device-trust-mesh:envelope:v1"
                  ],
                  "properties": {
                    "urn:device-trust-mesh:envelope:v1": {
                      "$ref": "#/$defs/Envelope"
                    }
                  }
                },
                "taskId": {
                  "default": "",
                  "description": "The ID of the task for this artifact.",
                  "type": "string"
                }
              },
              "title": "Task Artifact Update Event",
              "type": "object",
              "required": [
                "taskId",
                "contextId",
                "artifact",
                "metadata"
              ],
              "allOf": [
                {
                  "if": {
                    "required": [
                      "artifact"
                    ],
                    "properties": {
                      "artifact": {
                        "required": [
                          "name"
                        ],
                        "properties": {
                          "name": {
                            "const": "risk-assessment"
                          }
                        }
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "artifact": {
                        "properties": {
                          "parts": {
                            "prefixItems": [
                              {
                                "properties": {
                                  "data": {
                                    "$ref": "#/$defs/RiskAssessment"
                                  }
                                }
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "if": {
                    "required": [
                      "artifact"
                    ],
                    "properties": {
                      "artifact": {
                        "required": [
                          "name"
                        ],
                        "properties": {
                          "name": {
                            "const": "enrolment-decision"
                          }
                        }
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "artifact": {
                        "properties": {
                          "parts": {
                            "prefixItems": [
                              {
                                "properties": {
                                  "data": {
                                    "$ref": "#/$defs/EnrolmentDecision"
                                  }
                                }
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "if": {
                    "required": [
                      "artifact"
                    ],
                    "properties": {
                      "artifact": {
                        "required": [
                          "name"
                        ],
                        "properties": {
                          "name": {
                            "const": "step-up-challenge"
                          }
                        }
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "artifact": {
                        "properties": {
                          "parts": {
                            "prefixItems": [
                              {
                                "properties": {
                                  "data": {
                                    "$ref": "#/$defs/StepUpChallenge"
                                  }
                                }
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "if": {
                    "required": [
                      "artifact"
                    ],
                    "properties": {
                      "artifact": {
                        "required": [
                          "name"
                        ],
                        "properties": {
                          "name": {
                            "const": "audit-record"
                          }
                        }
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "artifact": {
                        "properties": {
                          "parts": {
                            "prefixItems": [
                              {
                                "properties": {
                                  "data": {
                                    "$ref": "#/$defs/AuditRecord"
                                  }
                                }
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "description": "Artifacts represent task outputs.",
      "properties": {
        "artifactId": {
          "default": "",
          "description": "Unique identifier (e.g. UUID) for the artifact. It must be unique within a task.",
          "type": "string"
        },
        "description": {
          "default": "",
          "description": "Optional. A human readable description of the artifact.",
          "type": "string"
        },
        "extensions": {
          "description": "The URIs of extensions that are present or contributed to this Artifact.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "metadata": {
          "$ref": "#/$defs/Struct",
          "description": "Optional. Metadata included with the artifact."
        },
        "name": {
          "default": "",
          "description": "A human readable name for the artifact.",
          "type": "string"
        },
        "parts": {
          "description": "The content of the artifact. Must contain at least one part.",
          "items": {
            "$ref": "#/$defs/Part"
          },
          "type": "array"
        }
      },
      "title": "Artifact",
      "type": "object"
    },
    "AuditRecord": {
      "title": "AuditRecord",
      "description": "audit-record artifact payload; mirrors the audit.log record.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auditId",
        "subjectTaskId"
      ],
      "properties": {
        "auditId": {
          "type": "string"
        },
        "subjectTaskId": {
          "type": "string"
        }
      }
    },
    "EnrolmentDecision": {
      "title": "EnrolmentDecision",
      "description": "enrolment-decision artifact payload.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "policyAction",
        "rationale"
      ],
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "GRANTED",
            "DENIED",
            "CHALLENGED",
            "READ_ONLY",
            "REMOVED"
          ]
        },
        "policyAction": {
          "type": "string",
          "enum": [
            "ALLOW",
            "BLOCK",
            "READ_ONLY",
            "CHALLENGE"
          ]
        },
        "rationale": {
          "type": "string"
        },
        "riskScore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "guardrails": {
          "description": "Guardrails that fired.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "asOf": {
          "description": "Context the agent saw, copied from the context-mcp as_of.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contextSeq",
            "materializedAt",
            "sourceOffsets"
          ],
          "properties": {
            "contextSeq": {
              "description": "device.context context_seq the decision used.",
              "type": "integer"
            },
            "materializedAt": {
              "description": "Epoch millis at which context-mcp materialized that context.",
              "type": "integer"
            },
            "sourceOffsets": {
              "description": "Source offsets applied by the materializer.",
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "topic",
                  "partition",
                  "offset"
                ],
                "properties": {
                  "topic": {
                    "type": "string"
                  },
                  "partition": {
                    "type": "integer"
                  },
                  "offset": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      }
    },
    "Envelope": {
      "title": "Envelope",
      "description": "Mesh envelope under metadata[\"urn:device-trust-mesh:envelope:v1\"]. Same fields as the Avro io.confluent.dtm.Envelope record, in camelCase.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "messageId",
        "correlationId",
        "agentId",
        "agentVersion",
        "configVersion",
        "eventTime",
        "deviceId",
        "mode"
      ],
      "properties": {
        "messageId": {
          "type": "string"
        },
        "correlationId": {
          "type": "string"
        },
        "causationId": {
          "type": "string"
        },
        "agentId": {
          "description": "flink:<statement>, agent:<name> or simulator.",
          "type": "string"
        },
        "agentVersion": {
          "type": "string"
        },
        "configVersion": {
          "description": "Hash of the effective agent config; n/a for Flink.",
          "type": "string"
        },
        "eventTime": {
          "description": "Producer-assigned epoch millis.",
          "type": "integer"
        },
        "deviceId": {
          "type": "string"
        },
        "customerId": {
          "type": "string"
        },
        "deviceSeq": {
          "type": "integer"
        },
        "requiredContextSeq": {
          "type": "integer"
        },
        "mode": {
          "type": "string",
          "enum": [
            "LIVE",
            "REPLAY"
          ]
        },
        "replayRunId": {
          "type": "string"
        }
      }
    },
    "Message": {
      "additionalProperties": false,
      "description": "`Message` is one unit of communication between client and server. It can be\n associated with a context and/or a task. For server messages, `context_id` must\n be provided, and `task_id` only if a task was created. For client messages, both\n fields are optional, with the caveat that if both are provided, they have to\n match (the `context_id` has to be the one that is set on the task). If only\n `task_id` is provided, the server will infer `context_id` from it.",
      "properties": {
        "contextId": {
          "default": "",
          "description": "Optional. The context id of the message. If set, the message will be associated with the given context.",
          "type": "string"
        },
        "extensions": {
          "description": "The URIs of extensions that are present or contributed to this Message.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "messageId": {
          "default": "",
          "description": "The unique identifier (e.g. UUID) of the message. This is created by the message creator.",
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/Struct",
          "description": "Optional. Any metadata to provide along with the message."
        },
        "parts": {
          "description": "Parts is the container of the message content.",
          "items": {
            "$ref": "#/$defs/Part"
          },
          "type": "array"
        },
        "referenceTaskIds": {
          "description": "A list of task IDs that this message references for additional context.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "role": {
          "anyOf": [
            {
              "pattern": "^ROLE_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "ROLE_USER",
                "ROLE_AGENT"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "description": "Identifies the sender of the message.",
          "title": "Role"
        },
        "taskId": {
          "default": "",
          "description": "Optional. The task id of the message. If set, the message will be associated with the given task.",
          "type": "string"
        }
      },
      "title": "Message",
      "type": "object"
    },
    "Part": {
      "additionalProperties": false,
      "description": "`Part` represents a container for a section of communication content.\n Parts can be purely textual, some sort of file (image, video, etc) or\n a structured data blob (i.e. JSON).",
      "properties": {
        "data": {
          "$ref": "#/$defs/Value",
          "description": "Arbitrary structured `data` as a JSON value (object, array, string, number, boolean, or null)."
        },
        "filename": {
          "default": "",
          "description": "An optional `filename` for the file (e.g., \"document.pdf\").",
          "type": "string"
        },
        "mediaType": {
          "default": "",
          "description": "The `media_type` (MIME type) of the part content (e.g., \"text/plain\", \"application/json\", \"image/png\").\n This field is available for all part types.",
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/Struct",
          "description": "Optional. metadata associated with this part."
        },
        "raw": {
          "description": "The `raw` byte content of a file. In JSON serialization, this is encoded as a base64 string.",
          "pattern": "^[A-Za-z0-9+/]*={0,2}$",
          "type": "string"
        },
        "text": {
          "description": "The string content of the `text` part.",
          "type": "string"
        },
        "url": {
          "description": "A `url` pointing to the file's content.",
          "type": "string"
        }
      },
      "title": "Part",
      "type": "object"
    },
    "RiskAssessment": {
      "title": "RiskAssessment",
      "description": "risk-assessment artifact payload.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "rationale",
        "signalIds",
        "asOf"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "rationale": {
          "type": "string"
        },
        "signalIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "asOf": {
          "description": "Context the agent saw, copied from the context-mcp as_of.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contextSeq",
            "materializedAt",
            "sourceOffsets"
          ],
          "properties": {
            "contextSeq": {
              "description": "device.context context_seq the decision used.",
              "type": "integer"
            },
            "materializedAt": {
              "description": "Epoch millis at which context-mcp materialized that context.",
              "type": "integer"
            },
            "sourceOffsets": {
              "description": "Source offsets applied by the materializer.",
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "topic",
                  "partition",
                  "offset"
                ],
                "properties": {
                  "topic": {
                    "type": "string"
                  },
                  "partition": {
                    "type": "integer"
                  },
                  "offset": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      }
    },
    "StepUpChallenge": {
      "title": "StepUpChallenge",
      "description": "step-up-challenge artifact payload.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "enrolmentTaskId"
      ],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "MFA_PUSH",
            "BIOMETRIC",
            "OTP"
          ]
        },
        "enrolmentTaskId": {
          "type": "string"
        }
      }
    },
    "Struct": {
      "title": "Struct",
      "type": "object"
    },
    "TaskStatus": {
      "additionalProperties": false,
      "description": "A container for the status of a task",
      "properties": {
        "message": {
          "$ref": "#/$defs/Message",
          "description": "A message associated with the status."
        },
        "state": {
          "anyOf": [
            {
              "pattern": "^TASK_STATE_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "TASK_STATE_SUBMITTED",
                "TASK_STATE_WORKING",
                "TASK_STATE_COMPLETED",
                "TASK_STATE_FAILED",
                "TASK_STATE_CANCELED",
                "TASK_STATE_INPUT_REQUIRED",
                "TASK_STATE_REJECTED",
                "TASK_STATE_AUTH_REQUIRED"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
